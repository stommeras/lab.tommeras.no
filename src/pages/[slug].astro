---
import { getCollection, render } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Layout from '../layouts/Layout.astro';
import EntryMeta from '../components/EntryMeta.astro';

// Each experiment's Demo.astro, keyed by its folder name
const demos = import.meta.glob<{ default: AstroComponentFactory }>('../experiments/*/Demo.astro', { eager: true });
// An experiment can add a Steps.astro, which renders under the note
const stepsComponents = import.meta.glob<{ default: AstroComponentFactory }>('../experiments/*/Steps.astro', {
  eager: true,
});

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const Demo = demos[`../experiments/${entry.id}/Demo.astro`]?.default;
const Steps = stepsComponents[`../experiments/${entry.id}/Steps.astro`]?.default;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Lab`} description={entry.data.summary.replaceAll('`', '')} slug={entry.id}>
  <h1 style={`view-transition-name: title-${entry.id}`}>{entry.data.title}</h1>
  <div class="byline">
    <EntryMeta data={entry.data} />
  </div>
  {Demo && <Demo />}
  <div class="note">
    <Content />
  </div>
  {Steps && <Steps />}
</Layout>

<style>
  /* As a full-width block, the view transition would stretch the small link snapshot to the column width */
  h1 {
    width: fit-content;
    view-transition-class: title;
  }

  .byline {
    margin-top: 1em;
  }

  .note {
    margin-top: 1em;
  }

  /* The Markdown note comes from another component, so these rules need :global to reach it */
  .note > :global(* + *) {
    margin-top: 1em;
  }

  .note > :global(:is(h2, h3)) {
    margin-top: 2em;
  }
</style>
