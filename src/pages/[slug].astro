---
import { getCollection, render } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Layout from '../layouts/Layout.astro';
import { STATUS_COLORS } from '../content.config';

// Each experiment's Demo.astro, keyed by its folder name
const demos = import.meta.glob<{ default: AstroComponentFactory }>('../experiments/*/Demo.astro', { eager: true });
// An experiment can add a Steps.astro, which renders under the note
const stepsComponents = import.meta.glob<{ default: AstroComponentFactory }>('../experiments/*/Steps.astro', {
  eager: true,
});

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const Demo = demos[`../experiments/${entry.id}/Demo.astro`]?.default;
const Steps = stepsComponents[`../experiments/${entry.id}/Steps.astro`]?.default;
const { Content } = await render(entry);
const date = entry.data.date.toISOString().slice(0, 10);
---

<Layout title={`${entry.data.title} | Lab`} description={entry.data.summary.replaceAll('`', '')}>
  <h1>{entry.data.title}</h1>
  <p class="meta">
    <time datetime={date}>{date}</time> ·{' '}
    <span style={{ color: STATUS_COLORS[entry.data.status] }}>{entry.data.status}</span> · {entry.data.language}
  </p>
  {Demo && <Demo />}
  <div class="note">
    <Content />
  </div>
  {Steps && <Steps />}
</Layout>

<style>
  .meta {
    margin-top: 1em;
    color: var(--muted);
  }

  .note {
    margin-top: 1em;
  }

  /* The Markdown note comes from another component, so these rules need :global to reach it */
  .note > :global(* + *) {
    margin-top: 1em;
  }

  .note > :global(:is(h2, h3)) {
    margin-top: 2em;
  }
</style>
