---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { STATUS_COLORS } from '../content.config';

const experiments = (await getCollection('experiments')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <h1>Lab</h1>
  <p class="intro">Eksperimenter, skisser og ting som kanskje ikke virker ennå.</p>
  {experiments.length ? (
    <ol>
      {experiments.map(({ id, data }) => {
        const date = data.date.toISOString().slice(0, 10);
        return (
          <li>
            <time datetime={date}>{date}</time>
            <span class="status" style={{ color: STATUS_COLORS[data.status] }}>{data.status}</span>
            <a href={`/${id}/`}>{data.title}</a>
            <span class="language">{data.language}</span>
            {data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
            {/* Backticks in the summary mark code, as in Markdown */}
            <p>{data.summary.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}</p>
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="intro">Ingen eksperimenter ennå.</p>
  )}
</Layout>

<style>
  h1 {
    font-size: 2rem;
  }

  .intro {
    margin-top: 1em;
  }

  .intro,
  time,
  li p {
    color: var(--muted);
  }

  ol {
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  li p {
    flex-basis: 100%;
  }

  .tag,
  .language {
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--lavender);
    font-size: 0.8125rem;
  }

  /* Languages are code, so they share the inline code color */
  .language {
    color: var(--mint);
  }
</style>
