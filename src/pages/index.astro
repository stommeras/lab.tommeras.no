---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const experiments = (await getCollection('experiments')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <h1>Lab</h1>
  <p class="intro">Eksperimenter, skisser og ting som kanskje ikke virker ennå.</p>
  {experiments.length ? (
    <ol>
      {experiments.map(({ id, data }) => {
        const date = data.date.toISOString().slice(0, 10);
        return (
          <li>
            <time datetime={date}>{date}</time>
            <span class="status">{data.status}</span>
            <a href={`/${id}/`}>{data.title}</a>
            <p>{data.summary}</p>
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="intro">Ingen eksperimenter ennå.</p>
  )}
</Layout>

<style>
  h1 {
    margin: 0;
    font-size: 2rem;
  }

  .intro,
  time,
  li p {
    color: var(--muted);
  }

  ol {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  li p {
    flex-basis: 100%;
    margin: 0;
  }

  .status {
    color: var(--peach);
  }
</style>
