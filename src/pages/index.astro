---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EntryMeta from '../components/EntryMeta.astro';
import CodeText from '../components/CodeText.astro';

const experiments = (await getCollection('experiments')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <h1>Lab</h1>
  <p class="intro">Eksperimenter, skisser og ting som kanskje ikke virker enda.</p>
  {experiments.length ? (
    <ol>
      {experiments.map(({ id, data }) => (
        <li>
          {/* Same name as the h1 on the experiment page, so the title grows into it on navigation */}
          <a href={`/${id}/`} style={`view-transition-name: title-${id}`}>
            {data.title}
          </a>
          <EntryMeta id={id} data={data} />
          <p>
            <CodeText text={data.summary} />
          </p>
        </li>
      ))}
    </ol>
  ) : (
    <p class="intro">Ingen eksperimenter enda.</p>
  )}
</Layout>

<style>
  h1 {
    font-size: 2rem;
  }

  .intro {
    margin-top: 1em;
  }

  .intro,
  li p {
    color: var(--muted);
  }

  ol {
    margin-top: 32px;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 4px;
    justify-items: start;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  li > a {
    font-weight: 700;
    view-transition-class: entry;
  }
</style>
