---
import type { CollectionEntry } from 'astro:content';
import EntryMeta from './EntryMeta.astro';
import CodeText from './CodeText.astro';
import { sharedEntryStyle } from '../lib/shared-entry';
import { TABLE, outline, rectangle, type Drawn } from '../lib/bench';

interface Props {
  // Only the experiments on the table, newest first
  experiments: CollectionEntry<'experiments'>[];
  // From arrange() in src/lib/workbench.ts
  table: Map<string, Drawn>;
  paper?: Drawn['footprint'];
  previews: Map<string, { light: string; dark: string } | undefined>;
  class?: string;
}

const { experiments, table: drawn, paper, previews, class: className } = Astro.props;
const sketch = (id: string) => experiments.find((entry) => entry.id === id)?.data.status === 'skisse';

// Objects further back are painted first. The list keeps the date order for screen readers and the tab order, so
// the painter's order goes in each object's z-index instead
const center = ({ footprint: [x0, y0, x1, y1] }: Drawn) => x0 + x1 + y0 + y1;
const rank = new Map([...drawn].sort(([, a], [, b]) => center(a) - center(b)).map(([id], i) => [id, i + 1]));

const { width: W, depth: D, thickness: T } = TABLE;
// The wooden table top under the mat: how far it reaches past the mat, how thick it is, and how wide its boards are
const WOOD = { margin: 5, thickness: 5, board: 8 };
const M = WOOD.margin;
const bottom = -T - WOOD.thickness;

// The viewBox fits the table, the tallest object and room for the lift on hover
// Matches the translate on hover in the styles below
const LIFT = 3;
const left = -D - 2 * M - 1;
const width = W + D + 4 * M + 2;
const top = Math.min(-M - 1, ...[...drawn.values()].map(({ screen }) => screen[1])) - LIFT - 1;
const height = (W + D) / 2 + M - bottom + 1 - top;
const viewBox = `${left} ${top} ${width} ${height}`;

// The visible faces of a block lying on the table: its top and the sides facing +y and +x
const slab = (x0: number, y0: number, x1: number, y1: number, z: number, thickness: number) => [
  [
    'y',
    outline([
      [x0, y1, z],
      [x1, y1, z],
      [x1, y1, z - thickness],
      [x0, y1, z - thickness],
    ]),
  ],
  [
    'x',
    outline([
      [x1, y0, z],
      [x1, y1, z],
      [x1, y1, z - thickness],
      [x1, y0, z - thickness],
    ]),
  ],
  ['t', rectangle(x0, y0, x1, y1, z)],
];
const table = slab(-M, -M, W + M, D + M, -T, WOOD.thickness);
const mat = slab(0, 0, W, D, 0, T);
// The boards run along x, so their seams cross the top and show as their ends on the side facing +x
let seams = '';
for (let y = -M + WOOD.board; y < D + M; y += WOOD.board)
  seams +=
    outline([
      [-M, y, -T],
      [W + M, y, -T],
    ]) +
    outline([
      [W + M, y, -T],
      [W + M, y, bottom],
    ]);
// Thin lines every other voxel and thicker ones every tenth, inside a plain border like on a real cutting mat
const BORDER = 2;
const lines = (major: boolean) => {
  const keep = (i: number) => (major ? (i - BORDER) % 10 === 0 : (i - BORDER) % 2 === 0 && (i - BORDER) % 10 !== 0);
  let d = '';
  for (let x = BORDER; x <= W - BORDER; x++)
    if (keep(x))
      d += outline([
        [x, BORDER, 0],
        [x, D - BORDER, 0],
      ]);
  for (let y = BORDER; y <= D - BORDER; y++)
    if (keep(y))
      d += outline([
        [BORDER, y, 0],
        [W - BORDER, y, 0],
      ]);
  return d;
};

// The blueprint paper under a sketch: a thin sheet with a fine grid, a border, and a title block in the left corner
const sheet = ([x0, y0, x1, y1]: Drawn['footprint']) => {
  let grid = '';
  for (let x = x0 + 2; x < x1 - 1; x += 2)
    grid += outline([
      [x, y0 + 1, 0],
      [x, y1 - 1, 0],
    ]);
  for (let y = y0 + 2; y < y1 - 1; y += 2)
    grid += outline([
      [x0 + 1, y, 0],
      [x1 - 1, y, 0],
    ]);
  const frame =
    rectangle(x0 + 1, y0 + 1, x1 - 1, y1 - 1) +
    rectangle(x0 + 1, y1 - 4, x0 + 10, y1 - 1) +
    outline([
      [x0 + 1, y1 - 2.5, 0],
      [x0 + 10, y1 - 2.5, 0],
    ]);
  return { faces: slab(x0, y0, x1, y1, 0, 0.3), grid, frame };
};
const blueprint = paper && sheet(paper);

// The card opens beside the object, on the side with more room, and stays within the height of the table
const card = ({ screen: [sx0, sy0, sx1, sy1] }: Drawn) => {
  const right = (sx0 + sx1) / 2 < left + width / 2;
  const x = ((right ? sx1 + 1 : sx0 - 1) - left) / width;
  const y = Math.min(0.62, Math.max(0.38, ((sy0 + sy1) / 2 - top) / height));
  return `--x: ${(x * 100).toFixed(2)}%; --y: ${(y * 100).toFixed(2)}%; --side: ${right ? 0 : -100}%`;
};
---

<div class:list={['bench', className]} style={`aspect-ratio: ${width} / ${height}`}>
  <svg class="mat" viewBox={viewBox} aria-hidden="true">
    {table.map(([face, d]) => (
      <path class={face} style="--c: var(--wood)" d={d} />
    ))}
    <path class="seams" d={seams} />
    {mat.map(([face, d]) => (
      <path class={face} style="--c: var(--mat)" d={d} />
    ))}
    <path class="grid" d={lines(false)} />
    <path class="grid major" d={lines(true)} />
    {
      blueprint && (
        <g class="sketch">
          {blueprint.faces.map(([face, d]) => (
            <path class={face} style="--c: var(--paper)" d={d} />
          ))}
          <path class="paper-grid" d={blueprint.grid} />
          <path class="paper-line" d={blueprint.frame} />
        </g>
      )
    }
  </svg>
  <ol aria-label="Eksperimenter på arbeidsbenken">
    {experiments.map(({ id, data }) => {
      const object = drawn.get(id)!;
      const [x0, y0, x1, y1] = object.footprint;
      const preview = previews.get(id);
      return (
        <li>
          <a href={`/${id}/`} aria-labelledby={`bench-${id}`} aria-describedby={`bench-${id}-summary`}>
            <svg
              class:list={{ sketch: sketch(id) }}
              viewBox={viewBox}
              aria-hidden="true"
              style={`z-index: ${rank.get(id)}`}
            >
              <path class="footprint" d={rectangle(x0 - 1, y0 - 1, x1 + 1, y1 + 1)} />
              <g class="voxels" set:html={object.markup} />
            </svg>
            <div class="card" style={card(object)}>
              {preview && (
                <picture>
                  <source media="(prefers-color-scheme: dark)" srcset={preview.dark} />
                  <img src={preview.light} alt="" width="300" height="188" loading="lazy" decoding="async" />
                </picture>
              )}
              <div class="caption">
                <span class="title" id={`bench-${id}`} style={sharedEntryStyle('title', id)}>
                  {data.title}
                </span>
                <EntryMeta id={id} data={data} />
                <p id={`bench-${id}-summary`}>
                  <CodeText text={data.summary} />
                </p>
              </div>
            </div>
          </a>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .bench {
    --mat: light-dark(color-mix(in oklch, var(--mint) 55%, var(--bg)), color-mix(in oklch, var(--mint) 30%, var(--bg)));
    --grid: color-mix(in oklch, var(--mint) 25%, var(--surface));
    --wood: light-dark(
      color-mix(in oklch, var(--peach) 45%, var(--surface)),
      color-mix(in oklch, var(--peach) 35%, var(--bg))
    );
    position: relative;
    /* The objects' z-index follows the painter's order, and the open card sits above all of them */
    isolation: isolate;
    /* Wider than the text column, centered on it. cqi is the width of the body, without the scrollbar */
    width: min(1200px, 100cqi - 32px);
    margin: 32px 0 48px calc(50% - min(600px, 50cqi - 16px));
  }

  /* The shadow on the floor under the table: a tight one where it meets the floor and a wide, soft one. Black barely
     shows on the dark background, so in dark mode it's a faint light instead */
  .mat {
    filter: drop-shadow(
        0 10px 8px light-dark(rgb(42 38 56 / 0.18), color-mix(in oklch, var(--lavender) 12%, transparent))
      )
      drop-shadow(0 36px 32px light-dark(rgb(42 38 56 / 0.2), color-mix(in oklch, var(--lavender) 16%, transparent)));
  }

  .seams {
    fill: none;
    stroke: color-mix(in oklch, var(--wood), black 22%);
    stroke-width: 0.15;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  /* Each face path gets its color from --c, lit from the top left. A stroke in the same color closes the
     hairline gaps that anti-aliasing leaves between neighbors */
  .bench :global(:is(.t, .x, .y)) {
    stroke-width: 0.04;
    stroke-linejoin: round;
  }

  .bench :global(.t) {
    fill: var(--c);
    stroke: var(--c);
  }

  .bench :global(.y) {
    --shade: color-mix(in oklch, var(--c), black 15%);
    fill: var(--shade);
    stroke: var(--shade);
  }

  .bench :global(.x) {
    --shade: color-mix(in oklch, var(--c), black 32%);
    fill: var(--shade);
    stroke: var(--shade);
  }

  /* Overlapping strokes would show as darker seams through the glass */
  .bench :global(.glass) {
    opacity: 0.45;
  }

  .bench :global(.glass path) {
    stroke: none;
  }

  /* Blueprint paper for the sheet and the sketches on it: lavender and mint meet in blue, and the lines are light in
     both schemes */
  .bench {
    --blue: color-mix(in oklch, var(--lavender) 55%, var(--mint));
    --paper: light-dark(var(--blue), color-mix(in oklch, var(--blue) 45%, var(--bg)));
    --ink: light-dark(var(--surface), var(--fg));
  }

  /* The drawing is flat paper color, so only its lines show its shape */
  .sketch .voxels :global(:is(.t, .x, .y)) {
    fill: var(--paper);
    stroke: var(--paper);
  }

  .sketch :global(:is(.edges, .paper-line, .paper-grid)) {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sketch :global(.edges) {
    stroke-width: 0.18;
  }

  .paper-line {
    stroke-width: 0.12;
    opacity: 0.8;
  }

  .paper-grid {
    stroke-width: 0.04;
    opacity: 0.3;
  }

  .grid {
    fill: none;
    stroke: var(--grid);
    stroke-width: 0.04;
    opacity: 0.6;
  }

  .grid.major {
    stroke-width: 0.2;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The object's voxels and its footprint are the link's hit area */
  a :global(:is(.voxels path, .footprint)) {
    pointer-events: visiblePainted;
    cursor: pointer;
  }

  a:focus-visible {
    outline: none;
  }

  .footprint {
    fill: color-mix(in oklch, var(--pink) 30%, transparent);
    stroke: var(--pink);
    stroke-width: 0.3;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .voxels {
    transition: translate 0.2s ease-out;
  }

  a:is(:hover, :focus-visible) .footprint {
    opacity: 1;
  }

  a:is(:hover, :focus-visible) .voxels {
    translate: 0 -3px;
  }

  .card {
    position: absolute;
    z-index: 99;
    top: var(--y);
    left: var(--x);
    width: 300px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 12px 32px -12px light-dark(rgb(42 38 56 / 0.35), rgb(0 0 0 / 0.6));
    color: var(--fg);
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0;
    visibility: hidden;
    translate: var(--side) -50%;
    scale: 0.96;
    pointer-events: none;
    transition:
      opacity 0.15s,
      scale 0.15s,
      visibility 0s 0.15s;
  }

  a:is(:hover, :focus-visible) .card {
    opacity: 1;
    visibility: visible;
    scale: 1;
    transition:
      opacity 0.15s,
      scale 0.15s;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--line);
  }

  .caption {
    display: grid;
    gap: 4px;
    padding: 12px 14px 14px;
  }

  /* As a block, the view transition would stretch the snapshot of the title to the width of the card */
  .title {
    width: fit-content;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .caption p {
    color: var(--muted);
  }

  /* The meta's tags sit on the right in the article byline. In the narrow card they wrap under */
  /* Only the open card takes part in the view transition. Coming back from an experiment, its heading then fades out
     instead of flying into a card nobody can see */
  a:not(:hover, :focus-visible) :is(.title, .caption :global(.meta)) {
    view-transition-name: none !important;
  }

  .caption :global(.tags) {
    margin-left: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .footprint,
    .voxels,
    .card {
      transition: none !important;
    }
  }
</style>
