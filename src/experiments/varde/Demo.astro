---
const playPath = 'M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z';
---

<div class="frame">
  <button type="button" class="button start-button">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={playPath} />
    </svg>
    Start
  </button>
</div>

<script>
  // public/varde/spill/ is Godot's web export. Its wasm and pck load only after the click.
  // The build uses threads, so vercel.json sends COOP and COEP for this page and the game folder under it.
  const frame = document.querySelector<HTMLElement>('.frame')!;
  const button = frame.querySelector<HTMLButtonElement>('.start-button')!;

  button.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    // The dev server serves no directory index for public/, so name the file
    iframe.src = '/varde/spill/index.html';
    iframe.title = 'Varde';
    // Godot reads the keys from its own canvas, so the iframe needs focus once it has loaded
    iframe.addEventListener('load', () => iframe.focus());
    button.replaceWith(iframe);
    // Godot sizes its canvas in device pixels, the iframe's CSS size times devicePixelRatio, and draws the 960×540
    // game at a whole multiple. A canvas under 960×540 crops the game, draws it off center and misplaces the mouse,
    // and one between two multiples leaves black bars. So the iframe gets the CSS size that makes the canvas a whole
    // multiple of 960×540, rounded up because Godot rounds down, and a CSS scale fits it to the frame. The browser
    // maps the mouse through the scale.
    const fit = () => {
      const ratio = devicePixelRatio;
      const multiple = Math.max(1, Math.floor(ratio));
      const width = Math.ceil((960 * multiple) / ratio);
      iframe.style.width = `${width}px`;
      iframe.style.height = `${Math.ceil((540 * multiple) / ratio)}px`;
      iframe.style.scale = String(frame.clientWidth / width);
    };
    fit();
    new ResizeObserver(fit).observe(frame);
    // Zooming changes devicePixelRatio and fires resize
    addEventListener('resize', fit);
  });
</script>

<style>
  /* The game renders at 960×540, so the frame reaches past the 760 px column, centered on it, to show it at 1:1.
     In a narrower window the frame shrinks, and the script scales the iframe to match. */
  .frame {
    --width: min(960px, 100vw - 36px);
    position: relative;
    box-sizing: content-box;
    width: var(--width);
    margin: 1em 0 0 calc(50% - var(--width) / 2 - 2px);
    aspect-ratio: 16 / 9;
    /* The scale doesn't shrink the iframe's layout box, so clip it */
    overflow: hidden;
    background: var(--surface);
    border: 2px solid var(--pink);
  }

  /* The script creates the iframe, so the scoped styles don't reach it */
  .frame :global(iframe) {
    display: block;
    border: 0;
    transform-origin: 0 0;
  }

  /* Matches the buttons in livets-spill/Demo.astro */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }

  .button:hover {
    border-color: var(--pink);
  }

  .start-button {
    position: absolute;
    inset: 0;
    margin: auto;
    width: fit-content;
    height: fit-content;
  }
</style>
