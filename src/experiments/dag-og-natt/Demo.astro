<style>
  /* The scene has its own palette and ignores light-dark() */
  .scene {
    --sky: #cfd8e3;
    --far: #7d91ab;
    --mid: #6b7485;
    --near: #4b5f70;
    --fjord: #9aabbc;
    --shore: #6b6159;
    --wall: #9c3a2c;
    --wall-shade: #7d2c22;
    --roof: #3b3033;
    --window: #2b1f1c;
    --spruce-lit: #2d5240;
    --spruce-shade: #1f3a2b;
    --trunk: #3b2a1e;
  }

  svg {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--sky);
  }

  .far-mountains {
    color: var(--far);
  }

  .mid-mountains {
    color: var(--mid);
  }

  .near-mountains {
    color: var(--near);
  }

  /* The stroke in the fill color hides the hairline seams that anti-aliasing leaves between faces */
  :is(.far-mountains, .mid-mountains, .near-mountains) path {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .fjord {
    fill: var(--fjord);
  }

  .shore path {
    fill: var(--shore);
  }

  .gable,
  .end-wall {
    fill: var(--wall);
  }

  .side-wall {
    fill: var(--wall-shade);
  }

  .roof {
    fill: var(--roof);
  }

  .door,
  .windows path {
    fill: var(--window);
  }

  .lit {
    fill: var(--spruce-lit);
  }

  .shade {
    fill: var(--spruce-shade);
  }

  .trunk {
    fill: var(--trunk);
  }
</style>
