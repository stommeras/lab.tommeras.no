---
import Scene from './Scene.astro';
---

<div class="dag-og-natt">
  <button class="preview" type="button" aria-label="Åpne i fullskjerm og scroll gjennom dagen">
    <Scene defs />
    <span class="hint chip" aria-hidden="true">
      Fullskjerm ↗
    </span>
  </button>
  <label class="time">
    Klokka
    <input type="range" min="0" max="1" step="0.001" value="0.44" />
  </label>
  <dialog aria-label="En dag i CSS" tabindex="-1">
    <div class="stage">
      <Scene />
    </div>
    <div class="track"></div>
    <button class="close chip" type="button">
      Lukk
    </button>
    <label class="time chip">
      Klokka
      <input type="range" min="0" max="1" step="0.001" value="0.44" />
    </label>
  </dialog>
</div>
<p class="unsupported">
  Nettleseren din støtter ikke scroll-driven animations (<code>animation-timeline</code>). Prøv Chrome eller Edge.
</p>

<script>
  const root = document.querySelector<HTMLElement>('.dag-og-natt')!;
  const preview = root.querySelector<HTMLButtonElement>('.preview')!;
  // One slider under the preview and one in the dialog. Both show the same time.
  const [previewInput, dialogInput] = root.querySelectorAll<HTMLInputElement>('.time input');
  const dialog = root.querySelector('dialog')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // Progress through the day, from 0 to 1. The keyframes turn it into --time and the sky colors.
  function setProgress(progress: number) {
    root.style.setProperty('--progress', String(progress));
    const time = parseFloat(getComputedStyle(preview).getPropertyValue('--time'));
    const hours = Math.floor(time);
    const minutes = Math.floor((time - hours) * 60);
    for (const slider of [previewInput, dialogInput]) {
      slider.value = String(progress);
      slider.setAttribute(
        'aria-valuetext',
        `kl. ${String(hours).padStart(2, '0')}.${String(minutes).padStart(2, '0')}`,
      );
    }
  }

  // The preview grows into the dialog and shrinks back, unless the visitor prefers reduced motion.
  // A browser without view transitions opens and closes the dialog at once.
  function transition(update: () => void) {
    if (reducedMotion.matches || !('startViewTransition' in document)) update();
    else document.startViewTransition({ update, types: ['dag-og-natt'] });
  }

  const maxScroll = () => dialog.scrollHeight - dialog.clientHeight;

  // The dialog's scroll position is the progress, so it opens at the preview's time
  preview.addEventListener('click', () =>
    transition(() => {
      dialog.showModal();
      // Focus on the dialog itself, so the arrow keys and space scroll the day instead of pressing Lukk
      dialog.focus();
      dialog.scrollTop = Number(previewInput.value) * maxScroll();
    }),
  );

  const close = () => transition(() => dialog.close());

  // The sliders follow the dialog's scroll, so every way of closing keeps the time
  dialog.addEventListener('scroll', () => setProgress(dialog.scrollTop / maxScroll()));

  // Esc would close the dialog at once, so the transition takes over
  dialog.addEventListener('cancel', (event) => {
    event.preventDefault();
    close();
  });
  root.querySelector('.close')!.addEventListener('click', close);
  previewInput.addEventListener('input', () => setProgress(Number(previewInput.value)));
  // The dialog's slider scrolls the dialog, and the scroll listener does the rest.
  // With reduced motion the dialog doesn't scroll, so the slider sets the time itself.
  dialogInput.addEventListener('input', () => {
    if (maxScroll() > 0) dialog.scrollTop = Number(dialogInput.value) * maxScroll();
    else setProgress(Number(dialogInput.value));
  });
  setProgress(Number(previewInput.value));
</script>

<style>
  /* Every effect in the scene derives from this number, the hour from 6 to 24 */
  @property --time {
    syntax: '<number>';
    inherits: true;
    initial-value: 12;
  }

  /* Registered so the keyframes can interpolate them. The initial values are the daytime sky. */
  @property --sky-top {
    syntax: '<color>';
    inherits: true;
    initial-value: #6fa4d8;
  }

  /* The sky at the horizon */
  @property --sky {
    syntax: '<color>';
    inherits: true;
    initial-value: #cfe2f0;
  }

  /* An integer, so counter-reset accepts it */
  @property --hour {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  /*
   * The keyframes run over the day's progress, from 0 to 1. The --time stops give dusk more of it
   * than midday. The sky stops in between sit at the progress of their hour: 8:00 is at 7%,
   * 16:00 at 36%, 18:00 at 49%, 19:00 at 58%.
   */
  @keyframes day {
    0% {
      --time: 6;
      --sky-top: #4a5a8a;
      --sky: #f0a989;
    }
    7% {
      --sky-top: #6fa4d8;
      --sky: #cfe2f0;
    }
    36% {
      --sky-top: #6fa4d8;
      --sky: #cfe2f0;
    }
    40% {
      --time: 17;
    }
    49% {
      --sky-top: #5c6fa8;
      --sky: #f4a261;
    }
    58% {
      --sky-top: #3a3f6e;
      --sky: #b0677a;
    }
    75% {
      --time: 21;
      --sky-top: #141a35;
      --sky: #2c3358;
    }
    100% {
      --time: 24;
      --sky-top: #070a1a;
      --sky: #151a33;
    }
  }

  /* The scroll version needs scroll timelines, which Firefox doesn't have yet */
  .dag-og-natt {
    display: none;
    --progress: 0.44;
  }

  @supports (animation-timeline: scroll()) {
    .dag-og-natt {
      display: block;
    }

    .unsupported {
      display: none;
    }
  }

  .unsupported {
    margin-top: 1em;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--peach);
  }

  /*
   * Both copies of the scene hold the same paused animation at the progress the slider sets.
   * Longhands, since the minifier folds a timeline into the animation shorthand and Chromium drops that.
   */
  .preview,
  .stage {
    position: relative;
    animation-name: day;
    animation-duration: 1s;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-play-state: paused;
    animation-delay: calc(var(--progress) * -1s);
  }

  .preview {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: 1em;
    padding: 0;
    border: 0;
    cursor: zoom-in;
    view-transition-name: dag-og-natt;
  }

  /* The readout moves on its own, instead of growing with the scene */
  .preview :global(.clock) {
    view-transition-name: dag-og-natt-clock;
  }

  /* Only one element can carry each name, so the open dialog takes them over */
  .dag-og-natt:has(dialog[open]) .preview,
  .dag-og-natt:has(dialog[open]) .preview :global(.clock) {
    view-transition-name: none;
  }

  dialog[open] .stage {
    view-transition-name: dag-og-natt;
  }

  dialog[open] .stage :global(.clock) {
    view-transition-name: dag-og-natt-clock;
  }

  /* A dark label over the scene. Global, since the readout in Scene.astro uses it too. */
  :global(.chip) {
    padding: 2px 8px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
  }

  .hint {
    position: absolute;
    top: 16px;
    right: 16px;
  }

  .time {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 8px;
  }

  .time input {
    flex: 1;
    accent-color: var(--pink);
  }

  /* The browser draws the page's scrollbar gutter above the dialog, so it goes away while the dialog is open */
  :global(html:has(.dag-og-natt dialog[open])) {
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  dialog {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  /* The dialog is the whole screen, so a focus ring around it adds nothing */
  dialog:focus-visible {
    outline: none;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100%;
  }

  /* Scroll is the clock. With reduced motion the dialog doesn't scroll and keeps the slider's time. */
  @media (prefers-reduced-motion: no-preference) {
    .track {
      height: 200%;
    }

    .stage {
      animation-duration: auto;
      animation-delay: 0s;
      animation-play-state: running;
      /* The dialog is the nearest scroller. Firefox with scroll-driven animations turned on, as in Zen, ignores a named scroll-timeline here. */
      animation-timeline: scroll();
    }
  }

  /* Leaves room for the kl. readout in the bottom left corner */
  dialog .time {
    position: fixed;
    right: 16px;
    bottom: 16px;
    left: 120px;
    margin: 0;
  }

  .close {
    position: fixed;
    top: 16px;
    right: 16px;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  /* Fill the growing box with each snapshot, anchored at the bottom like the SVG's slice */
  :global(::view-transition-group(dag-og-natt)),
  :global(::view-transition-group(dag-og-natt-clock)) {
    animation-duration: 0.4s;
  }

  :global(::view-transition-old(dag-og-natt)),
  :global(::view-transition-new(dag-og-natt)) {
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }

  /* The layout delays the new page for navigations, but the dialog should fade in while the scene grows */
  :global(:root:active-view-transition-type(dag-og-natt)::view-transition-new(root)) {
    animation-delay: 0s;
  }
</style>
