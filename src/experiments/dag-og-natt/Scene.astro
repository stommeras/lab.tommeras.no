<style>
  svg {
    --far: #7d91ab;
    --mid: #6b7485;
    --near: #4b5f70;
    --fjord: #9aabbc;
    --shore: #6b6159;
    --wall: #9c3a2c;
    --wall-shade: #7d2c22;
    --roof: #3b3033;
    --window: #2b1f1c;
    --spruce-lit: #2d5240;
    --spruce-shade: #1f3a2b;
    --trunk: #3b2a1e;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(var(--sky-top), var(--sky-horizon));
  }

  .sun,
  .moon {
    --arc-center-x: 381px;
    --arc-center-y: 440px;
    --arc-radius-x: 330px;
    --arc-radius-y: 250px;
    --angle: calc(var(--time) / 24 * 360deg - 90deg);
    cx: calc(var(--arc-center-x) - cos(var(--angle)) * var(--arc-radius-x));
    cy: calc(var(--arc-center-y) - sin(var(--angle)) * var(--arc-radius-y));
  }

  .sun {
    fill: #fff1c4;
  }

  .moon {
    --angle: calc(var(--time) / 24 * 360deg + 90deg);
    fill: #e4e8ef;
  }

  /* Angles use the arc's frame: 0deg points left, toward the morning sun, 90deg up, 180deg right */
  svg {
    --sun-angle: calc(var(--time) / 24 * 360deg - 90deg);
    --moon-angle: calc(var(--sun-angle) + 180deg);
    --daylight: clamp(0, sin(var(--sun-angle)) * 2.5, 1);
    --moonlight: calc(clamp(0, sin(var(--moon-angle)) * 2.5, 1) * 0.3);
    /* How far the rock keeps its day colors. Still most of the way at sunrise and sunset, gone a while after dusk */
    --day-tint: clamp(0, sin(var(--sun-angle)) * 2 + 0.6, 1);
    --rock-night: #161c2c;
    --rock-moonlit: #5d6a85;
  }

  .far-mountains {
    --rock-lit: #a9b8cc;
    --rock-shade: var(--far);
    --haze: 55%;
  }

  .mid-mountains {
    --rock-lit: #a6aebc;
    --rock-shade: var(--mid);
    --haze: 20%;
  }

  .near-mountains {
    --rock-lit: #8a9aa6;
    --rock-shade: var(--near);
    --haze: 10%;
  }

  /*
    --face is the angle a face points in, in the same frame as the sun. A face lights up as the sun lines up with it,
    the moon lights it a little at night, and every face fades toward the sky's horizon color with distance.
    The stroke in the fill color hides the hairline seams that anti-aliasing leaves between faces.
  */
  :is(.far-mountains, .mid-mountains, .near-mountains) path {
    --face: 90deg;
    --light: calc(
      max(0, cos(var(--sun-angle) - var(--face))) * var(--daylight) + max(0, cos(var(--moon-angle) - var(--face))) *
        var(--moonlight)
    );
    --lit: color-mix(in oklch, var(--rock-lit) calc(var(--day-tint) * 100%), var(--rock-moonlit));
    --shade: color-mix(in oklch, var(--rock-shade) calc(var(--day-tint) * 100%), var(--rock-night));
    color: color-mix(
      in oklch,
      var(--sky-horizon) var(--haze),
      color-mix(in oklch, var(--lit) calc(min(1, var(--light)) * 100%), var(--shade))
    );
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .fjord {
    fill: var(--fjord);
  }

  .shore path {
    fill: var(--shore);
  }

  .gable,
  .end-wall {
    fill: var(--wall);
  }

  .side-wall {
    fill: var(--wall-shade);
  }

  .roof {
    fill: var(--roof);
  }

  .door,
  .windows path {
    fill: var(--window);
  }

  .trees {
    --tree-lit: var(--spruce-lit);
    --tree-shade: var(--spruce-shade);
  }

  /* Custom properties inherit into the <use> clone, so a mirrored tree swaps its lit and shaded sides */
  .trees .flipped {
    --tree-lit: var(--spruce-shade);
    --tree-shade: var(--spruce-lit);
  }

  .lit {
    fill: var(--tree-lit);
  }

  .shade {
    fill: var(--tree-shade);
  }

  .trunk {
    fill: var(--trunk);
  }
</style>
