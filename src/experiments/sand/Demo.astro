---
// Grid size in cells, one canvas pixel per cell
const cols = 200;
const rows = 150;

// Each name must match a key in MATERIALS in the script and a .swatch class
const materials = [
  { name: 'sand', label: 'Sand' },
  { name: 'water', label: 'Vann' },
  { name: 'stone', label: 'Stein' },
  { name: 'empty', label: 'Viskelær' },
];
---

<div class="demo">
  <div class="canvas-frame">
    <canvas
      class="canvas"
      width={cols}
      height={rows}
      role="img"
      aria-label="Tegneflate med sand, vann og stein. Tegn med mus eller finger."
    ></canvas>
    <p class="hint" aria-hidden="true">
      Tegn med mus eller finger
    </p>
  </div>
  <div class="material-picker">
    {materials.map(({ name, label }, index) => (
      <button type="button" class="material-button" data-material={name} aria-pressed={index === 0 ? 'true' : 'false'}>
        {name === 'empty' ? (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21" />
            <path d="m5.082 11.09 8.828 8.828" />
          </svg>
        ) : (
          <span class:list={['swatch', name]} aria-hidden="true" />
        )}
        {label}
      </button>
    ))}
    <button type="button" class="clear-button">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m16 22-1-4" />
        <path d="M19 14a1 1 0 0 0 1-1v-1a2 2 0 0 0-2-2h-3a1 1 0 0 1-1-1V4a2 2 0 0 0-4 0v5a1 1 0 0 1-1 1H6a2 2 0 0 0-2 2v1a1 1 0 0 0 1 1" />
        <path d="M19 14H5l-1.973 6.767A1 1 0 0 0 4 22h16a1 1 0 0 0 .973-1.233z" />
        <path d="m8 22 1-4" />
      </svg>
      Tøm
    </button>
  </div>
</div>

<script>
  import { toRgba, type Rgba } from '../../lib/color';

  // --- Materials ---

  const EMPTY = 0;
  const SAND = 1;
  const WATER = 2;
  const STONE = 3;
  // Returned for cells outside the grid, so the edges act as walls
  const FULL = 255;

  // The most cells water can flow sideways in one frame. Higher levels out faster.
  const WATER_SPREAD = 6;
  // Chance that water under the surface flows into a cell vacated this frame. Higher lets holes race to the wall.
  const UNDERWATER_CHAIN = 0.8;
  // Chance per frame that a grain sinks into water. Lower makes sand sink slower.
  const SAND_SINK_CHANCE = 0.5;
  // Speed gained per frame while falling, and its cap, in cells per frame
  const GRAVITY = 0.1;
  const MAX_SPEED = 5;
  // Fixed simulation rate. Every per-frame rate above means per step.
  const STEPS_PER_SECOND = 60;
  // Step cap per render, so a slow device runs in slow motion instead of falling behind
  const MAX_STEPS_PER_RENDER = 4;
  // Most random darkening per grain. Higher gives piles more texture.
  const MAX_SHADE = 16;
  // Share of rough grains. Higher makes pile sides steeper and more uneven.
  const ROUGH_CHANCE = 0.15;

  const MATERIALS: Record<string, number> = { empty: EMPTY, sand: SAND, water: WATER, stone: STONE };

  // --- Grid ---

  // Other demos on the page, like the steps under the note, use the same class names, so look up inside this one
  const demo = document.querySelector<HTMLElement>('.demo')!;
  const canvas = demo.querySelector<HTMLCanvasElement>('.canvas')!;
  const hint = demo.querySelector<HTMLElement>('.hint')!;
  const COLS = canvas.width;
  const ROWS = canvas.height;

  const grid = new Uint8Array(COLS * ROWS);
  // The frame each cell last moved on, so nothing moves twice in one frame
  const movedOn = new Uint32Array(COLS * ROWS);
  const shades = new Uint8Array(COLS * ROWS);
  const rough = new Uint8Array(COLS * ROWS);
  // Falling speed in cells per frame. 0 for any cell that isn't falling.
  const velocity = new Float32Array(COLS * ROWS);

  // Starts at 1 on the first step, so it never matches a fresh movedOn. At 60 steps a second it takes over
  // two years to wrap.
  let frame = 0;

  let changed = true;

  type Point = { x: number; y: number };

  const inBounds = (x: number, y: number) => x >= 0 && x < COLS && y >= 0 && y < ROWS;
  const indexOf = (x: number, y: number) => y * COLS + x;

  const getCell = (x: number, y: number) => (inBounds(x, y) ? grid[indexOf(x, y)] : FULL);
  const setCell = (x: number, y: number, value: number, shade: number) => {
    if (inBounds(x, y)) {
      grid[indexOf(x, y)] = value;
      shades[indexOf(x, y)] = shade;
      rough[indexOf(x, y)] = value === SAND && Math.random() < ROUGH_CHANCE ? 1 : 0;
      velocity[indexOf(x, y)] = 0;
      changed = true;
    }
  };
  const isEmpty = (x: number, y: number) => getCell(x, y) === EMPTY;
  const hasMoved = (x: number, y: number) => inBounds(x, y) && movedOn[indexOf(x, y)] === frame;
  // Sand can't take water that already moved, or the water rides up a falling column in one frame
  const sandCanEnter = (x: number, y: number) => {
    const cell = getCell(x, y);
    return cell === EMPTY || (cell === WATER && !hasMoved(x, y));
  };
  // Does nothing if either cell is outside the grid, so FULL never gets written into it
  const swap = (x1: number, y1: number, x2: number, y2: number) => {
    if (!inBounds(x1, y1) || !inBounds(x2, y2)) return;
    const a = indexOf(x1, y1);
    const b = indexOf(x2, y2);
    [grid[a], grid[b]] = [grid[b], grid[a]];
    [shades[a], shades[b]] = [shades[b], shades[a]];
    [rough[a], rough[b]] = [rough[b], rough[a]];
    // A move ends any fall. fall() sets the new speed after its swap.
    velocity[a] = 0;
    velocity[b] = 0;
    movedOn[a] = frame;
    movedOn[b] = frame;
    changed = true;
  };

  // --- Simulation ---

  const randomSide = () => (Math.random() < 0.5 ? -1 : 1);

  // Flips every frame so neither side wins when grains compete for a cell
  let leftToRight = true;

  // Callers check that the cell below is empty
  const fall = (x: number, y: number) => {
    const i = indexOf(x, y);
    const speed = Math.min(Math.max(velocity[i], 1) + GRAVITY, MAX_SPEED);
    let distance = 1;
    while (distance < Math.floor(speed) && isEmpty(x, y + distance + 1)) distance++;
    swap(x, y, x, y + distance);
    velocity[indexOf(x, y + distance)] = speed;
  };

  // A rough grain only slides to a side where it would keep falling after the step
  const canSlide = (x: number, y: number, dx: number) =>
    sandCanEnter(x + dx, y) && sandCanEnter(x + dx, y + 1) && (!rough[indexOf(x, y)] || sandCanEnter(x + dx, y + 2));

  const stepSand = (x: number, y: number) => {
    if (isEmpty(x, y + 1)) {
      fall(x, y);
      return;
    }
    // Landed
    velocity[indexOf(x, y)] = 0;

    const canDown = sandCanEnter(x, y + 1);
    const canLeft = !canDown && canSlide(x, y, -1);
    const canRight = !canDown && canSlide(x, y, 1);

    let dx;
    if (canDown) {
      dx = 0;
    } else if (canLeft && canRight) {
      dx = randomSide();
    } else if (canLeft) {
      dx = -1;
    } else if (canRight) {
      dx = 1;
    } else {
      return;
    }

    if (getCell(x + dx, y + 1) === WATER && Math.random() >= SAND_SINK_CHANCE) return;

    swap(x, y, x + dx, y + 1);
  };

  // Limits the chain under the surface, or an erased hole races to the wall in one frame
  const canFlowInto = (x: number, y: number, atSurface: boolean) =>
    isEmpty(x, y) && (atSurface || !hasMoved(x, y) || Math.random() < UNDERWATER_CHAIN);

  // How many cells in a row water can flow into toward dx, up to max
  const flowDistance = (x: number, y: number, dx: number, max: number, atSurface: boolean) => {
    let distance = 0;
    while (distance < max && canFlowInto(x + dx * (distance + 1), y, atSurface)) distance++;
    return distance;
  };

  const stepWater = (x: number, y: number) => {
    if (isEmpty(x, y + 1)) {
      fall(x, y);
      return;
    }
    // Landed
    velocity[indexOf(x, y)] = 0;

    const atSurface = getCell(x, y - 1) !== WATER;
    const canDownLeft = isEmpty(x - 1, y) && isEmpty(x - 1, y + 1);
    const canDownRight = isEmpty(x + 1, y) && isEmpty(x + 1, y + 1);

    let dx;
    let dy = 1;

    if (canDownLeft && canDownRight) {
      dx = randomSide();
    } else if (canDownLeft) {
      dx = -1;
    } else if (canDownRight) {
      dx = 1;
    } else {
      // A random reach per move keeps neighbors from moving in lockstep
      const reach = 1 + Math.floor(Math.random() * WATER_SPREAD);
      const left = flowDistance(x, y, -1, reach, atSurface);
      const right = flowDistance(x, y, 1, reach, atSurface);
      if (!left && !right) return;

      const side = left && right ? randomSide() : left ? -1 : 1;
      dx = side === -1 ? -left : right;
      dy = 0;
    }

    swap(x, y, x + dx, y + dy);
  };

  // Bottom-up, so a grain that falls lands in a row that's already done and moves once per frame
  const step = () => {
    frame++;

    leftToRight = !leftToRight;

    for (let y = ROWS - 1; y >= 0; y--) {
      for (let i = 0; i < COLS; i++) {
        const x = leftToRight ? i : COLS - 1 - i;

        if (hasMoved(x, y)) continue;

        switch (getCell(x, y)) {
          case SAND:
            stepSand(x, y);
            break;
          case WATER:
            stepWater(x, y);
            break;
        }
      }
    }
  };

  // --- Rendering ---

  const TRANSPARENT: Rgba = [0, 0, 0, 0];

  // A canvas can't use CSS variables, so read the resolved token color from the material's swatch
  const swatchColor = (name: string) =>
    toRgba(getComputedStyle(demo.querySelector(`.swatch.${name}`)!).backgroundColor);

  const colors: Rgba[] = [];
  let outlineColor: Rgba;
  let outlineOnFilledColor: Rgba;

  const readColors = () => {
    for (const [name, material] of Object.entries(MATERIALS)) {
      colors[material] = material === EMPTY ? TRANSPARENT : swatchColor(name);
    }
    outlineColor = toRgba(getComputedStyle(canvas).borderTopColor);
    outlineOnFilledColor = toRgba(getComputedStyle(document.body).backgroundColor);
  };
  readColors();

  // The tokens use light-dark(), so the colors change with the system theme. Off screen the loop is stopped, and it
  // renders the new colors when it starts again.
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    readColors();
    changed = true;
  });

  const ctx = canvas.getContext('2d')!;
  const image = ctx.createImageData(COLS, ROWS);

  const drawOutlinePixel = (point: Point) => {
    if (!inBounds(point.x, point.y)) return;
    const color = isEmpty(point.x, point.y) ? outlineColor : outlineOnFilledColor;
    image.data.set(color, indexOf(point.x, point.y) * 4);
  };

  // image.data clamps to 0, so subtracting the shade never wraps around
  const render = () => {
    const data = image.data;
    for (let i = 0; i < grid.length; i++) {
      const color = colors[grid[i]];
      const shade = shades[i];
      const p = i * 4;
      data[p] = color[0] - shade;
      data[p + 1] = color[1] - shade;
      data[p + 2] = color[2] - shade;
      data[p + 3] = color[3];
    }

    if (material === EMPTY && hover) {
      for (const point of brushOutline(hover, brushRadius(material))) drawOutlinePixel(point);
    }

    ctx.putImageData(image, 0, 0);

    const hasContent = grid.some((cell) => cell !== EMPTY);
    hint.classList.toggle('hidden', hasContent);
  };

  // --- Painting ---

  const isInsideBrush = (dx: number, dy: number, r: number) => dx * dx + dy * dy <= (r + 0.5) * (r + 0.5);

  const brushRadius = (value: number) => (value === EMPTY ? 4 : 2);

  const paintCircle = (center: Point, value: number) => {
    const radius = brushRadius(value);
    for (let dy = -radius; dy <= radius; dy++) {
      for (let dx = -radius; dx <= radius; dx++) {
        if (!isInsideBrush(dx, dy, radius)) continue;

        const x = center.x + dx;
        const y = center.y + dy;
        if (value === EMPTY || isEmpty(x, y)) setCell(x, y, value, Math.floor(Math.random() * MAX_SHADE));
      }
    }
  };

  const brushOutline = (center: Point, radius: number) => {
    const points: Point[] = [];
    for (let dy = -radius; dy <= radius; dy++) {
      for (let dx = -radius; dx <= radius; dx++) {
        if (!isInsideBrush(dx, dy, radius)) continue;

        const onEdge =
          !isInsideBrush(dx - 1, dy, radius) ||
          !isInsideBrush(dx + 1, dy, radius) ||
          !isInsideBrush(dx, dy - 1, radius) ||
          !isInsideBrush(dx, dy + 1, radius);
        if (onEdge) points.push({ x: center.x + dx, y: center.y + dy });
      }
    }
    return points;
  };

  const lerp = (from: number, to: number, t: number) => Math.round(from + (to - from) * t);

  // Pointer events arrive about once per frame, so stamp between them to avoid gaps
  const paintLine = (from: Point, to: Point, value: number) => {
    const steps = Math.max(Math.abs(to.x - from.x), Math.abs(to.y - from.y));
    for (let i = 0; i <= steps; i++) {
      const t = steps === 0 ? 0 : i / steps;
      paintCircle({ x: lerp(from.x, to.x, t), y: lerp(from.y, to.y, t) }, value);
    }
  };

  // --- Input ---

  let material = SAND;
  let isDrawing = false;
  let pointer: Point = { x: 0, y: 0 };
  let hover: Point | null = null;

  const materialButtons = demo.querySelectorAll<HTMLButtonElement>('.material-button');

  const selectMaterial = (selected: HTMLButtonElement) => {
    material = MATERIALS[selected.dataset.material!];
    canvas.classList.toggle('erasing', material === EMPTY);
    changed = true;
    for (const button of materialButtons) {
      button.setAttribute('aria-pressed', String(button === selected));
    }
  };

  for (const button of materialButtons) {
    button.addEventListener('click', () => selectMaterial(button));
  }

  demo.querySelector('.clear-button')!.addEventListener('click', () => {
    grid.fill(0);
    shades.fill(0);
    rough.fill(0);
    velocity.fill(0);
    movedOn.fill(0);
    changed = true;
  });

  // offsetX and clientWidth are measured inside the border, so the border doesn't skew the position
  const toGridPosition = (event: PointerEvent): Point => ({
    x: Math.floor((event.offsetX / canvas.clientWidth) * COLS),
    y: Math.floor((event.offsetY / canvas.clientHeight) * ROWS),
  });

  canvas.addEventListener('pointerdown', (event) => {
    canvas.setPointerCapture(event.pointerId);
    isDrawing = true;
    pointer = toGridPosition(event);
    paintCircle(pointer, material);
  });

  canvas.addEventListener('pointermove', (event) => {
    // Tracked without the button held too, so the eraser outline follows the cursor
    hover = toGridPosition(event);
    changed = true;
    if (!isDrawing) return;
    paintLine(pointer, hover, material);
    pointer = hover;
  });

  canvas.addEventListener('pointerleave', () => {
    hover = null;
    changed = true;
  });

  const stopDrawing = () => (isDrawing = false);
  canvas.addEventListener('pointerup', stopDrawing);
  canvas.addEventListener('pointercancel', stopDrawing);

  // --- Main loop ---

  const STEP_MS = 1000 / STEPS_PER_SECOND;
  let lastTime: number | null = null;
  let pending = 0;

  let frameRequest: number | null = null;

  const loop = (now: number) => {
    // Capped, so a tab that comes back from the background doesn't run a burst of catch-up steps
    pending += Math.min(now - (lastTime ?? now), MAX_STEPS_PER_RENDER * STEP_MS);
    lastTime = now;

    for (let steps = 0; pending >= STEP_MS && steps < MAX_STEPS_PER_RENDER; steps++) {
      // Inside the step loop, so the pour rate doesn't depend on the refresh rate
      if (isDrawing) paintCircle(pointer, material);
      step();
      pending -= STEP_MS;
    }

    if (changed) {
      render();
      changed = false;
    }
    frameRequest = requestAnimationFrame(loop);
  };

  const startLoop = () => {
    if (frameRequest !== null) return;
    // The time spent off screen isn't simulated
    lastTime = null;
    frameRequest = requestAnimationFrame(loop);
  };

  const stopLoop = () => {
    if (frameRequest === null) return;
    cancelAnimationFrame(frameRequest);
    frameRequest = null;
  };

  // The observer reports the initial state on its own, which starts the loop
  new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) startLoop();
      else stopLoop();
    }
  }).observe(canvas);
</script>

<style>
  .demo {
    margin: 32px 0 48px;
  }

  .canvas-frame {
    position: relative;
  }

  .canvas {
    border: 2px solid var(--pink);
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    /* Dragging on a touch screen draws instead of scrolling the page */
    touch-action: none;
  }

  .canvas.erasing {
    cursor: none;
  }

  .hint {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--muted);
    pointer-events: none;
  }

  .hint.hidden {
    display: none;
  }

  .material-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .material-button,
  .clear-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
  }

  .material-button:hover,
  .clear-button:hover {
    border-color: var(--pink);
  }

  .clear-button {
    margin-left: auto;
  }

  /* box-shadow thickens the border without resizing the button and leaves outline free for focus */
  .material-button[aria-pressed='true'] {
    border-color: var(--pink);
    box-shadow: 0 0 0 1px var(--pink);
    background: color-mix(in oklch, var(--pink) 14%, var(--surface));
  }

  /* On a phone the buttons fill each row to line up with the canvas edges */
  @media (max-width: 600px) {
    .material-button,
    .clear-button {
      flex: 1 0 auto;
    }
  }

  .swatch {
    width: 16px;
    height: 16px;
    border-radius: 4px;
  }

  /* The script reads these as canvas colors. Peach is dark in light mode, so sand mixes it lighter. */
  .swatch.sand {
    background: light-dark(color-mix(in oklch, var(--peach) 70%, var(--surface)), var(--peach));
  }

  .swatch.water {
    background: var(--lavender);
  }

  .swatch.stone {
    background: var(--muted);
  }
</style>
