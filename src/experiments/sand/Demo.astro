---
// Grid size in cells. The canvas has one pixel per cell, and CSS scales it up.
const cols = 200;
const rows = 150;
---

<div>
  <canvas class="canvas" width={cols} height={rows}></canvas>
  <div class="sand-color" hidden aria-hidden="true"></div>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.canvas')!;
  const COLS = canvas.width;
  const ROWS = canvas.height;

  const EMPTY = 0;
  const SAND = 1;
  const FULL = 255;

  const toRgb = (selector: string) => {
    const color = getComputedStyle(document.querySelector(selector)!).color;
    const [r, g, b] = color.match(/\d+/g)!.map(Number);
    return [r, g, b, 255];
  };

  const colors = [[0, 0, 0, 0], toRgb('.sand-color')];

  const grid = new Uint8Array(COLS * ROWS);
  const getCell = (x: number, y: number) => {
    if (x < 0 || x >= COLS || y < 0 || y >= ROWS) return FULL;
    return grid[y * COLS + x];
  };
  const setCell = (x: number, y: number, value: number) => (grid[y * COLS + x] = value);

  const ctx = canvas.getContext('2d')!;
  const image = ctx.createImageData(COLS, ROWS);

  const render = () => {
    for (let i = 0; i < grid.length; i++) {
      const [r, g, b, a] = colors[grid[i]];
      const index = i * 4;
      image.data[index] = r;
      image.data[index + 1] = g;
      image.data[index + 2] = b;
      image.data[index + 3] = a;
    }
    ctx.putImageData(image, 0, 0);
  };

  // Flips every frame so the scan order doesn't favor one side when grains compete for a cell
  let leftToRight = true;

  const step = () => {
    leftToRight = !leftToRight;
    for (let y = ROWS - 1; y >= 0; y--) {
      for (let i = 0; i < COLS; i++) {
        const x = leftToRight ? i : COLS - 1 - i;
        if (getCell(x, y) !== SAND) continue;

        const canDown = getCell(x, y + 1) === EMPTY;
        const canLeft = getCell(x - 1, y) === EMPTY && getCell(x - 1, y + 1) === EMPTY;
        const canRight = getCell(x + 1, y) === EMPTY && getCell(x + 1, y + 1) === EMPTY;

        let dx;
        if (canDown) {
          dx = 0;
        } else if (canLeft && canRight) {
          dx = Math.random() < 0.5 ? -1 : 1;
        } else if (canLeft) {
          dx = -1;
        } else if (canRight) {
          dx = 1;
        } else {
          continue;
        }

        setCell(x, y, EMPTY);
        setCell(x + dx, y + 1, SAND);
      }
    }
  };

  const spawn = () => {
    setCell(75, 50, SAND);
  };

  requestAnimationFrame(function loop() {
    step();
    spawn();
    render();
    requestAnimationFrame(loop);
  });
</script>

<style>
  .canvas {
    border: 1px solid var(--pink);
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }

  .sand-color {
    color: var(--peach);
  }
</style>
