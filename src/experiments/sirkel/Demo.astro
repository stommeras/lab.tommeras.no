---
// The layout is all CSS. The script only adds and removes dots.
const count = 12;
---

<div class="stage">
  <div class="ring" aria-hidden="true">
    {Array.from({ length: count }, () => (
      <span class="dot"></span>
    ))}
  </div>
  <div class="controls">
    <button type="button" data-step="-1">
      Fjern
    </button>
    <output aria-live="polite">{count} prikker</output>
    <button type="button" data-step="1">
      Legg til
    </button>
  </div>
</div>
<p class="unsupported">
  Nettleseren din støtter ikke <code>sibling-index()</code>. Prøv å oppdatere den.
</p>

<script>
  const ring = document.querySelector('.ring')!;
  const output = document.querySelector('.controls output')!;

  for (const button of document.querySelectorAll<HTMLButtonElement>('.controls button')) {
    button.addEventListener('click', () => {
      const dots = ring.children.length;
      if (button.dataset.step === '1' && dots < 36) ring.append(ring.lastElementChild!.cloneNode());
      if (button.dataset.step === '-1' && dots > 1) ring.lastElementChild!.remove();
      const now = ring.children.length;
      output.textContent = `${now} ${now === 1 ? 'prikk' : 'prikker'}`;
    });
  }
</script>

<style>
  .stage {
    display: none;
  }

  @supports (width: calc(sibling-index() * 1px)) {
    .stage {
      display: block;
      margin-bottom: 48px;
    }

    .unsupported {
      display: none;
    }
  }

  .ring {
    position: relative;
    width: min(100%, 400px);
    aspect-ratio: 1;
    margin: 32px auto;
    container-type: inline-size;
    transition: rotate 1.2s ease;
  }

  .ring:hover {
    rotate: 0.5turn;
  }

  .dot {
    /* Start at the top and go clockwise */
    --angle: calc(360deg / sibling-count() * (sibling-index() - 1) - 90deg);
    position: absolute;
    inset: 0;
    width: 10cqi;
    height: 10cqi;
    margin: auto;
    border-radius: 50%;
    background: light-dark(
      oklch(60% 0.15 calc(360 / sibling-count() * sibling-index())),
      oklch(80% 0.12 calc(360 / sibling-count() * sibling-index()))
    );
    translate: calc(cos(var(--angle)) * 40cqi) calc(sin(var(--angle)) * 40cqi);
    transition:
      translate 0.5s ease,
      scale 0.3s ease;
  }

  @starting-style {
    .dot {
      scale: 0;
    }
  }

  .controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  output {
    min-width: 11ch;
    text-align: center;
    color: var(--muted);
  }

  button {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--pink);
  }

  .unsupported {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--peach);
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .dot {
      transition: none;
    }
  }
</style>
