---
// Bottom to top, so the index is the layer's height in the stack
const layers = [
  {
    id: 'case',
    label: 'Kassen',
    color: 'var(--muted)',
    about: 'Skallet alt ligger i. Den holder resten på plass og bestemmer mye av hvordan tastaturet høres ut når du skriver.',
  },
  {
    id: 'pcb',
    label: 'Kretskortet',
    color: 'var(--mint)',
    about:
      'Kortet som merker tastetrykkene. Under hver bryter sitter to kontakter og en diode, sånn at flere taster kan holdes nede samtidig. Mikrokontrolleren sender trykkene videre over USB-C.',
  },
  {
    id: 'plate',
    label: 'Platen',
    color: 'color-mix(in oklab, var(--fg) 45%, var(--surface))',
    about: 'En plate, ofte av metall, med et hull for hver bryter. Bryterne klikker fast i hullene, så de står stødig når du trykker.',
  },
  {
    id: 'stabilizers',
    label: 'Stabilisatorer',
    color: 'var(--pink)',
    about:
      'Under de lange tastene sitter en bøyle av ståltråd mellom to holdere. Den gjør at mellomromstasten går rett ned, også når du trykker helt ute på kanten.',
  },
  {
    id: 'switches',
    label: 'Brytere',
    color: 'var(--peach)',
    about: 'En fjær og en kontakt for hver tast. Når du trykker, lukker bryteren kretsen, og kretskortet merker trykket.',
  },
  {
    id: 'keycaps',
    label: 'Tastene',
    color: 'var(--lavender)',
    about: 'Plastkappene du ser og tar på. De sitter løst på bryterne, så du kan dra dem av og bytte dem.',
  },
];

// A 60% ANSI layout as [legend, width in units]. Every row is 15 units wide.
const ones = (legends: string) => [...legends].map((legend): [string, number] => [legend, 1]);
const rows: [string, number][][] = [
  [['Esc', 1], ...ones('1234567890-='), ['⌫', 2]],
  [['Tab', 1.5], ...ones('QWERTYUIOP[]'), ['\\', 1.5]],
  [['Caps', 1.75], ...ones("ASDFGHJKL;'"), ['Enter', 2.25]],
  [['Shift', 2.25], ...ones('ZXCVBNM,./'), ['Shift', 2.75]],
  [['Ctrl', 1.25], ['Win', 1.25], ['Alt', 1.25], ['', 6.25], ['Alt', 1.25], ['Fn', 1.25], ['Win', 1.25], ['Ctrl', 1.25]],
];
const keys = rows.flat().map(([legend, width]) => ({ legend, width }));
const gridLayers = new Set(['pcb', 'plate', 'stabilizers', 'switches', 'keycaps']);
---

<section class="sprengskisse" aria-label="Et mekanisk tastatur delt opp i lag">
  <div class="stage">
    <div class="object" aria-hidden="true" style={`--middle: ${(layers.length - 1) / 2}`}>
      {
        layers.map(({ id, color }, i) => (
          <div class:list={['layer', id]} data-part={id} style={`--layer: ${i}; --color: ${color}`}>
            <span class="anchor" style={`anchor-name: --${id}`} />
            {gridLayers.has(id) &&
              keys.map(({ legend, width }) => (
                // The grid has four columns per unit
                <div class:list={['key', { long: width >= 2 }]} style={`grid-column: span ${width * 4}`}>
                  {id === 'keycaps' && legend}
                </div>
              ))}
            {id === 'pcb' && [<div class="usb" />, <div class="mcu" />]}
            {id === 'case' && [1, 2, 3, 4, 5, 6].map((step) => <div class="rim" style={`--step: ${step}`} />)}
          </div>
        ))
      }
    </div>
    <ul class="labels">
      {
        layers.map(({ id, label, color }) => (
          <li class="label" data-part={id} style={`position-anchor: --${id}; --color: ${color}`}>
            <button type="button" popovertarget={`sprengskisse-${id}`}>
              {label}
            </button>
          </li>
        ))
      }
    </ul>
    <p class="hint" aria-hidden="true">Scroll for å ta det fra hverandre ↓</p>
    <label class="toggle">
      <input type="checkbox" />
      Sett sammen
    </label>
  </div>
  {
    layers.map(({ id, label, about }) => (
      <div class="about" id={`sprengskisse-${id}`} popover>
        <strong>{label}</strong>
        <p>{about}</p>
      </div>
    ))
  }
</section>

<style>
  /* Registered so they can animate and transition. Without the scroll animation, the keyboard shows
     tilted (--tilt's initial value) and exploded (.stage sets --spread). */
  @property --spread {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  @property --tilt {
    syntax: '<angle>';
    inherits: true;
    initial-value: 55deg;
  }

  /* Tilt, spread, hold, then the same way back so it ends assembled and flat */
  @keyframes explode {
    0%,
    100% {
      --tilt: 0deg;
      --spread: 0px;
    }
    20%,
    80% {
      --tilt: 55deg;
      --spread: 0px;
    }
    40%,
    60% {
      --tilt: 55deg;
      --spread: var(--full-spread);
    }
  }

  /* Hidden as well as transparent, so a faded label can't be hovered or clicked */
  @keyframes labels {
    0%,
    30%,
    70%,
    100% {
      opacity: 0;
      visibility: hidden;
    }
    40%,
    60% {
      opacity: 1;
      visibility: visible;
    }
  }

  @keyframes hint {
    0% {
      opacity: 1;
    }
    8%,
    100% {
      opacity: 0;
      visibility: hidden;
    }
  }

  .sprengskisse {
    view-timeline: --explode;
  }

  .stage {
    /* How far apart the layers move. Everything that depends on the spread reads it from here. */
    --full-spread: 70px;
    --spread: var(--full-spread);
    position: relative;
    display: grid;
    place-items: center;
    height: 70vh;
    min-height: 28rem;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  /* No perspective: Chrome 155 tracks an anchor through 3D transforms but leaves perspective
     out, so a label drifts off its layer as the layer moves along Z. Orthographic matches a
     manual's exploded view anyway. */
  .object {
    --unit: clamp(0.6rem, 3vw, 1.25rem);
    /* How far apart the layers are, from 0 to 1 */
    --progress: calc(var(--spread) / var(--full-spread));
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    transform: rotateX(var(--tilt)) rotateZ(calc(var(--tilt) * -0.6));
  }

  /* All layers share one grid cell. Assembled, they rest a small gap apart like a real stack.
     They spread from the middle of the stack, so it stays centered. */
  .layer {
    /* Everything on a layer is painted from --paint, so dimming a layer only has to change it */
    --paint: var(--color);
    --edge: color-mix(in oklab, var(--paint), black 35%);
    --thickness: 0.25rem;
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(60, 1fr);
    grid-auto-rows: 1fr;
    width: calc(15 * var(--unit));
    height: calc(5 * var(--unit));
    padding: calc(0.4 * var(--unit));
    border-radius: calc(0.4 * var(--unit));
    transform-style: preserve-3d;
    transform: translateZ(calc((var(--layer) - var(--middle)) * (var(--spread) + 0.25 * var(--unit))));
  }

  /* The side of a slab: a darker copy just under it, which shows along the near edges once tilted */
  .case,
  .pcb,
  .plate {
    background: var(--paint);
    box-shadow: inset 0 0 0 1px var(--edge);
  }

  .case::after,
  .pcb::after,
  .switches .key::after,
  .stabilizers .long::after,
  .keycaps .key::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--edge);
    transform: translateZ(calc(-1 * var(--thickness)));
  }

  /* A bit larger than the other layers, so they fit inside its walls */
  .case {
    --thickness: 1.5rem;
    position: relative;
    width: calc(15.6 * var(--unit));
    height: calc(5.6 * var(--unit));
  }

  /* The walls of the case are frames stacked up along Z. Upright faces would be simpler, but
     Chrome's 3D sorting splits planes that cross, and that cut holes in the PCB. */
  .rim {
    --wall: calc(0.7 * var(--unit));
    position: absolute;
    inset: 0;
    border: calc(0.3 * var(--unit)) solid color-mix(in oklab, var(--paint), black 15%);
    border-radius: inherit;
    transform: translateZ(calc(var(--step) / 6 * var(--wall)));
  }

  .rim:last-child {
    border-color: color-mix(in oklab, var(--paint), white 15%);
  }

  .pcb {
    --pad: color-mix(in oklab, var(--paint), white 55%);
    position: relative;
  }

  /* A switch footprint under each key: the center hole, two pins and a diode */
  .pcb .key {
    --u: var(--unit);
    background:
      radial-gradient(circle at 50% 45%, var(--edge) 0 calc(0.13 * var(--u)), transparent 0),
      radial-gradient(circle at calc(50% - 0.2 * var(--u)) 25%, var(--pad) 0 calc(0.06 * var(--u)), transparent 0),
      radial-gradient(circle at calc(50% + 0.12 * var(--u)) 20%, var(--pad) 0 calc(0.06 * var(--u)), transparent 0),
      linear-gradient(var(--edge) 0 0) 50% 88% / calc(0.32 * var(--u)) calc(0.1 * var(--u)) no-repeat;
  }

  .usb,
  .mcu {
    position: absolute;
  }

  /* The USB-C port sits on the back edge and sticks out a little */
  .usb {
    top: calc(-0.15 * var(--unit));
    left: calc(50% - 0.35 * var(--unit));
    width: calc(0.7 * var(--unit));
    height: calc(0.35 * var(--unit));
    border-radius: calc(0.12 * var(--unit));
    background: var(--pad);
  }

  /* The microcontroller, between the number row and the top letter row */
  .mcu {
    top: calc(1.05 * var(--unit));
    left: calc(50% + 1.6 * var(--unit));
    width: calc(0.7 * var(--unit));
    height: calc(0.7 * var(--unit));
    border: calc(0.05 * var(--unit)) dashed var(--pad);
    background: var(--edge);
    rotate: 45deg;
  }

  /* The plate is the borders around each key, so the holes are see-through */
  .plate {
    background: none;
    box-shadow: inset 0 0 0 calc(0.4 * var(--unit)) var(--paint);
  }

  .plate .key {
    border: calc(0.16 * var(--unit)) solid var(--paint);
  }

  .key {
    position: relative;
    border-radius: 0.15rem;
    transform-style: preserve-3d;
  }

  /* A wire bar between two housings, under every key that is 2 units or wider */
  .stabilizers .long {
    --thickness: 0.2rem;
    margin: calc(0.3 * var(--unit)) calc(0.1 * var(--unit));
    background:
      linear-gradient(var(--paint) 0 0) left / calc(0.3 * var(--unit)) 100% no-repeat,
      linear-gradient(var(--paint) 0 0) right / calc(0.3 * var(--unit)) 100% no-repeat,
      linear-gradient(var(--paint) 0 0) center / 100% calc(0.08 * var(--unit)) no-repeat;
  }

  /* The side face only under the housings, not under the gap around the wire */
  .stabilizers .long::after {
    background:
      linear-gradient(var(--edge) 0 0) left / calc(0.3 * var(--unit)) 100% no-repeat,
      linear-gradient(var(--edge) 0 0) right / calc(0.3 * var(--unit)) 100% no-repeat;
  }

  .switches .key {
    --thickness: 0.3rem;
    margin: calc(0.24 * var(--unit));
    background: var(--paint);
  }

  .keycaps .key {
    --thickness: 0.35rem;
    /* Its place in the wave, from 0 for the first key to 1 for the last */
    --order: calc((sibling-index() - 1) / 60);
    margin: calc(0.06 * var(--unit));
    border-radius: 0.2rem;
    background: var(--paint);
    box-shadow: inset 0 0 0 0.15rem color-mix(in oklab, var(--paint), white 20%);
    padding: calc(0.1 * var(--unit)) calc(0.15 * var(--unit));
    /* --surface is dark in dark mode, where the caps are light, and the other way round */
    color: var(--surface);
    font-size: calc(0.32 * var(--unit));
    line-height: 1;
    /* Each cap sits on its switch until its turn in the wave, then lifts to the keycaps layer.
       The lag is at most one layer gap at full spread, so a cap never sinks below the switches. */
    transform: translateZ(
      calc((clamp(0, var(--progress) * 1.6 - var(--order) * 0.6, 1) - var(--progress)) * var(--full-spread))
    );
  }

  /* On a narrow screen, move the keyboard left to make room for the labels */
  @media (width < 40rem) {
    .object {
      margin-right: 9rem;
    }

    .label {
      --leader: 1rem;
      font-size: 0.8rem;
    }
  }

  /* The point each leader line ends at: the front right corner of the key area. Once tilted, it's
     the rightmost point of the part, so the line doesn't cross it, and the layers above never cover it. */
  .anchor {
    position: absolute;
    bottom: calc(0.4 * var(--unit));
    right: calc(0.4 * var(--unit));
  }

  /* The case is 0.3 units wider on each side, so this keeps its label in line with the others */
  .case .anchor {
    bottom: calc(0.7 * var(--unit));
    right: calc(0.7 * var(--unit));
  }

  /* No stabilizer sits in the front right corner, so point at the right housing under right shift */
  .stabilizers .anchor {
    bottom: calc(1.7 * var(--unit));
    right: calc(0.5 * var(--unit));
  }

  .labels {
    display: contents;
    list-style: none;
  }

  /* The label box is the leader line. It runs from its own anchor to a column shared by all labels,
     set by the keycaps' anchor, so the lines differ in length and the text lines up. */
  .label {
    --leader: 2rem;
    position: absolute;
    top: anchor(center);
    left: anchor(right);
    right: calc(anchor(--keycaps right) - var(--leader));
    border-top: 1px solid var(--fg);
    color: var(--fg);
  }

  .label button {
    position: absolute;
    left: calc(100% + 0.5rem);
    translate: 0 -50%;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }

  /* A short text about the part, under the label that opened it */
  .about {
    position-area: bottom span-left;
    position-try-fallbacks: flip-block;
    max-width: min(20rem, calc(100vw - 2rem));
    margin: 0.5rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--fg);

    p {
      margin: 0.25rem 0 0;
    }
  }

  /* A dot where the line meets the part */
  .label::before {
    content: '';
    position: absolute;
    top: -0.2rem;
    left: -0.2rem;
    width: 0.4rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: currentColor;
  }

  /* Without the scroll animation, a checkbox moves the layers together and apart */
  .stage {
    transition: --spread 0.8s ease-in-out;
  }

  .stage:has(.toggle :checked) {
    --spread: 0px;

    .label {
      opacity: 0;
      visibility: hidden;
    }
  }

  .label {
    transition:
      opacity 0.3s,
      visibility 0.3s;
  }

  /* Only shown while the scroll animation runs, and gone as soon as it starts */
  .hint {
    display: none;
    position: absolute;
    bottom: 1rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .toggle {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
  }

  .toggle input {
    margin: 0;
    accent-color: var(--pink);
  }

  /* Hovering a part or its label, or focusing the label, dims the other parts and labels. Opacity would flatten the
     layer's 3D children, so the dimming mixes the colors toward the background instead. */
  .stage:has([data-part='case']:is(:hover, :focus-within)) :not([data-part='case']),
  .stage:has([data-part='pcb']:is(:hover, :focus-within)) :not([data-part='pcb']),
  .stage:has([data-part='plate']:is(:hover, :focus-within)) :not([data-part='plate']),
  .stage:has([data-part='stabilizers']:is(:hover, :focus-within)) :not([data-part='stabilizers']),
  .stage:has([data-part='switches']:is(:hover, :focus-within)) :not([data-part='switches']),
  .stage:has([data-part='keycaps']:is(:hover, :focus-within)) :not([data-part='keycaps']) {
    &.layer {
      --paint: color-mix(in oklab, var(--color) 25%, var(--surface));
    }

    &.label {
      color: var(--muted);
      border-color: var(--line);
    }
  }

  /* Without anchor positioning, the labels become a legend under the keyboard. Firefox 157 has
     anchor positioning, but places anchors from their untransformed boxes, so every label lands
     in the same spot. Firefox also lacks scroll timelines, so that is the test for it. */
  @supports not ((anchor-name: --a) and (animation-timeline: view())) {
    .stage {
      padding-bottom: 4rem;
    }

    .labels {
      position: absolute;
      bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      justify-content: center;
      margin: 0;
      padding: 0 1rem;
      list-style: none;
    }

    .label {
      position: static;
      border-top: none;
      border-bottom: 0.25rem solid var(--color);
    }

    .label button {
      position: static;
      translate: none;
    }

    .label::before {
      content: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sprengskisse {
      height: 300vh;
    }

    .stage {
      position: sticky;
      top: 15vh;
    }

    @supports (animation-timeline: view()) {
      .stage,
      .label {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --explode;
        animation-range: contain 0% contain 100%;
      }

      /* The timing function applies to each step between keyframes, so every phase eases in and out */
      .toggle {
        display: none;
      }

      .hint {
        display: block;
        animation: hint linear both;
        animation-timeline: --explode;
        animation-range: contain 0% contain 100%;
      }

      .stage {
        animation-name: explode;
        animation-timing-function: ease-in-out;
      }

      .label {
        animation-name: labels;
      }
    }
  }
</style>
