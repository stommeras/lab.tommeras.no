---
import { Font } from 'astro:assets';
import '../styles/reset.css';

interface Props {
  title?: string;
  description?: string;
  slug?: string;
}

const { title = 'Lab | Tømmerås', description = 'Eksperimenter av Steffen Tømmerås.', slug } = Astro.props;

// A path like tommeras.no / lab / sirkel, built from the URL. The last part is the current page.
const parts = Astro.url.pathname.split('/').filter(Boolean);
const crumbs = [
  { label: 'tommeras.no', href: 'https://tommeras.no' },
  { label: 'lab', href: '/' },
  ...parts.map((part, i) => ({ label: part, href: `/${parts.slice(0, i + 1).join('/')}/` })),
];

const repo = 'https://github.com/stommeras/lab.tommeras.no';
const source = slug ? `${repo}/tree/main/src/experiments/${slug}` : repo;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-mono" preload={[{ style: 'normal' }]} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Brødsmulesti">
        <ol>
          {crumbs.map(({ label, href }, i) => (
            <li>{i < crumbs.length - 1 ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>
          ))}
        </ol>
      </nav>
      <a class="source" href={source}>
        kildekode
      </a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  const source = document.querySelector<HTMLAnchorElement>('header .source')!.href.replace('https://', '');
  const lines = [
    '',
    'Velkommen, utvikler!',
    '',
    'Nettsiden er designet og laget av',
    'Steffen Tømmerås',
    '',
    'Se kildekoden på:',
    source,
    '',
  ];
  const padding = 5;
  const width = Math.max(...lines.map((line) => line.length)) + 2 * padding;
  const center = (line: string) => {
    const left = Math.floor((width - line.length) / 2);
    return `║${' '.repeat(left)}${line}${' '.repeat(width - line.length - left)}║`;
  };
  console.log(['', `╔${'═'.repeat(width)}╗`, ...lines.map(center), `╚${'═'.repeat(width)}╝`, ''].join('\n'));
</script>

<style is:global>
  /* Copied from src/layouts/Layout.astro in tommeras.no. Update both when one changes. */
  :root {
    color-scheme: light dark;
    --bg: light-dark(#eeeaf4, #16151d);
    --surface: light-dark(#fbfafd, #1e1c27);
    --chrome: light-dark(#e4dfee, #26232f);
    --line: light-dark(#d6d0e3, #34303f);
    --fg: light-dark(#2a2638, #e6e2f0);
    --muted: light-dark(#625c78, #a39db8);
    /* Light-mode pink and mint are darkened to reach 4.5:1 on --chrome, the darkest light background */
    --pink: light-dark(#a73b6e, #f2a7c3);
    --lavender: light-dark(#6a51c9, #bba8f5);
    --mint: light-dark(#1f6f53, #9edbbf);
    --peach: light-dark(#a2561c, #f3c29a);
  }

  /* Both pages opt in, so navigation between them animates. With reduced motion the page swaps like before. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }
  }

  /* An experiment title growing into the page header, or back, set by index.astro and [slug].astro */
  ::view-transition-group(.title) {
    animation-duration: 0.4s;
  }

  :focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  html {
    background: var(--bg);
  }

  body {
    container: page / inline-size;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--fg);
    text-decoration: underline 2px var(--pink);
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--pink);
  }

  :not(pre) > code {
    color: var(--mint);
    white-space: nowrap;
  }

  pre {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  /* Shiki sets the theme's background inline, so only !important can swap it for the site's surface color */
  pre.astro-code {
    background-color: var(--surface) !important;
  }

  @media (max-width: 600px) {
    body {
      font-size: 0.9375rem;
    }
  }
</style>

<style>
  header,
  main {
    /* 760 px of content plus the padding */
    max-width: 792px;
    margin: 0 auto;
    padding: 24px 16px;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 24px;
  }

  .source {
    font-size: 0.9375rem;
  }

  .source::after {
    content: ' ↗' / '';
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  /* The slash is decoration, so screen readers get an empty alt text instead */
  li + li::before {
    content: '/' / '';
    margin-right: 8px;
    color: var(--muted);
  }

  [aria-current] {
    color: var(--muted);
  }
</style>
