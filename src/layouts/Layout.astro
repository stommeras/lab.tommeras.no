---
import { Font } from 'astro:assets';
import '../styles/reset.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Lab | Tømmerås', description = 'Eksperimenter av Steffen Tømmerås.' } = Astro.props;

// A path like tommeras.no / lab / sirkel, built from the URL. The last part is the current page.
const parts = Astro.url.pathname.split('/').filter(Boolean);
const crumbs = [
  { label: 'tommeras.no', href: 'https://tommeras.no' },
  { label: 'lab', href: '/' },
  ...parts.map((part, i) => ({ label: part, href: `/${parts.slice(0, i + 1).join('/')}/` })),
];
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-mono" preload={[{ style: 'normal' }]} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Brødsmulesti">
        <ol>
          {crumbs.map(({ label, href }, i) => (
            <li>{i < crumbs.length - 1 ? <a href={href}>{label}</a> : <span aria-current="page">{label}</span>}</li>
          ))}
        </ol>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Copied from src/layouts/Layout.astro in tommeras.no. Update both when one changes. */
  :root {
    color-scheme: light dark;
    --bg: light-dark(#eeeaf4, #16151d);
    --surface: light-dark(#fbfafd, #1e1c27);
    --chrome: light-dark(#e4dfee, #26232f);
    --line: light-dark(#d6d0e3, #34303f);
    --fg: light-dark(#2a2638, #e6e2f0);
    --muted: light-dark(#625c78, #a39db8);
    --pink: light-dark(#b5487a, #f2a7c3);
    --lavender: light-dark(#6a51c9, #bba8f5);
    --mint: light-dark(#2c7a5d, #9edbbf);
    --peach: light-dark(#a2561c, #f3c29a);
  }

  /* The browser's default ring disappears on the dark background */
  :focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  body {
    /* A component can ask how wide the page is, without the scrollbar. The sand steps use it to put their timeline
       in the margin when it fits. */
    container: page / inline-size;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--fg);
    text-decoration: underline 2px var(--pink);
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--pink);
  }

  /* Everything is monospace already, so inline code stands out by color */
  code {
    color: var(--mint);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    body {
      font-size: 0.9375rem;
    }
  }
</style>

<style>
  header,
  main {
    /* 760 px of content plus the padding */
    max-width: 792px;
    margin: 0 auto;
    padding: 24px 16px;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  /* The slash is decoration, so screen readers get an empty alt text instead */
  li + li::before {
    content: '/' / '';
    margin-right: 8px;
    color: var(--muted);
  }

  [aria-current] {
    color: var(--muted);
  }
</style>
